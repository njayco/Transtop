# Documentation only. Configure actual values securely; never commit credentials.
# PostgreSQL is supplied by the hosting environment.
DATABASE_URL=
COMMUNITY_MIN_CONTRIBUTORS=3
TRANSIT_AUTO_IMPORT=false
# Set a MapLibre style URL from a basemap provider licensed for your traffic.
# Vite reads VITE_ variables at build time; set this in the web artifact.
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
