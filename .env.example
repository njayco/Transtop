# Direct Transport for London Unified API (server only; never VITE_ prefixed)
WMATA_API_KEY=
# Owner-confirmed account daily allowance; leave 0 until verified.
# App caps total at 5,000/day, split 10% dev / 90% production.
WMATA_VERIFIED_DAILY_LIMIT=0
WMATA_ENABLED=true
TFL_API_KEY=
# Set false to disable direct TfL requests; shared cap is fixed below public baseline.
TFL_ENABLED=true
# Documentation only. Configure actual values securely; never commit credentials.
# PostgreSQL is supplied by the hosting environment.
DATABASE_URL=
COMMUNITY_MIN_CONTRIBUTORS=3
TRANSIT_AUTO_IMPORT=false
# Add the actual browser key through Replit Secrets, never in this file.
# Browser keys are public in the built client; restrict by website and API in Google Cloud.
# Enable Maps JavaScript API and billing. VITE_ values are read at build time.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
# Optional Google Cloud map ID; DEMO_MAP_ID is used for development when absent.
VITE_GOOGLE_MAPS_MAP_ID=
