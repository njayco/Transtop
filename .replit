modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.shared]
TRANSIT_AUTO_IMPORT = "true"
TRANSITLAND_ALLOW_BILLABLE = "true"
TRANSITLAND_ENABLED = "true"
TRANSITLAND_MONTHLY_REQUEST_LIMIT = "9999"
TRANSITLAND_PLAN = "production"
IDFM_PUBLIC_COMPLIANCE_CONFIRMED = "true"
PRIM_PUBLIC_COMPLIANCE_CONFIRMED = "true"


