{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:wmata": "tsx --test tests/wmata.ts",
    "test:wmata-import": "tsx tests/wmata-import.ts",
    "test:entry-country": "tsx --test tests/entry-country.ts",
    "prepare:entry-country": "node scripts/prepare-country-database.mjs",
    "import-gtfs": "tsx src/transit/import-cli.ts",
    "restore-legacy-gtfs": "tsx src/transit/legacy-rollback-cli.ts",
    "test:gtfs-import": "tsx tests/gtfs-import.ts",
    "test:catalog-timetable": "tsx --experimental-test-module-mocks --test tests/catalog-timetable.ts",
    "test:odpt": "tsx tests/odpt.ts",
    "check:odpt-live": "tsx tests/odpt-live.ts",
    "test:tfl": "tsx tests/tfl.ts",
    "check:tfl-live": "tsx tests/tfl-live.ts",
    "bench:gtfs": "tsx tests/gtfs-performance.ts && tsx tests/gtfs-cleanup-performance.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "ipaddr.js": "^2.5.0",
    "luxon": "^3.7.2",
    "mmdb-lib": "^3.0.3",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "protobufjs": "^8.8.1",
    "unzipper": "^0.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/unzipper": "^0.10.11",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
